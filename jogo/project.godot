; Arquivo de projeto do Godot 4.

config_version=5

[application]

config/name="Maré"
config/description="Sobrevivência em primeira pessoa no mangue."
config/icon="res://assets/logo_caranguejo.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="mare_jogo"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Mundo="*res://scripts/mundo.gd"
Texturas="*res://scripts/texturas.gd"
Config="*res://scripts/config.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/ssao/quality=0
environment/ssao/half_size=true
